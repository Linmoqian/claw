# 当前默认供应商：zdtaichu、openai-compatible 或 llama-cpp
AI_PROVIDER=zdtaichu
AI_MODEL=ZDTaichu5.0-9B
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_API_KEY=
AI_SUPPORTS_VISION=true
AI_MAX_TOKENS=128

ZDTAICHU_PYTHON=C:\Users\30470\Anaconda3\envs\zdtaichu\python.exe
ZDTAICHU_MODEL_PATH=D:\models\ZDTaichu5.0-9B

# llama.cpp 使用已启动的 llama-server：AI_PROVIDER=llama-cpp，AI_MODEL 留空可自动识别。
# AI_BASE_URL=http://127.0.0.1:8080/v1
# AI_SUPPORTS_VISION=false
# AI_BRIDGE_PYTHON=python
# LLAMA_CPP_API_KEY=
