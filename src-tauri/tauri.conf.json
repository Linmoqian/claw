{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "虾烤工作台",
  "version": "0.1.0",
  "identifier": "com.tauri-app.claw",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "虾烤工作台",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
